{
  "layer": "top",
  "position": "top",
  "height": 28,
  "exclusive": true,
  "fixed-center": true,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "custom/tamber",
    "sway/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "bluetooth",
    "custom/controls"
  ],
  "custom/tamber": {
    "format": "\u2726",
    "tooltip": "Open application launcher",
    "on-click": "tamber-desktop --command launcher",
    "on-click-right": "tamber-desktop --command games"
  },
  "sway/workspaces": {
    "all-outputs": true,
    "disable-scroll": true,
    "format": "\u2022",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    },
    "format-icons": {}
  },
  "sway/window": {
    "max-length": 16,
    "format": "{title}",
    "rewrite": {
      "^$": "Desktop"
    }
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "cpu": {
    "interval": 3,
    "format": "CPU {usage}%",
    "min-length": 8
  },
  "memory": {
    "interval": 5,
    "format": "RAM {percentage}%",
    "min-length": 8
  },
  "network": {
    "format-wifi": "\u25c8",
    "format-ethernet": "\u25c8",
    "format-disconnected": "\u25c7",
    "tooltip": true,
    "interval": 5
  },
  "pulseaudio": {
    "format": "\u25d6",
    "format-muted": "\u00d7",
    "scroll-step": 5,
    "min-length": 1,
    "tooltip-format": "Output {volume}%"
  },
  "bluetooth": {
    "format": "\u16d2",
    "format-disabled": "\u16d2",
    "format-connected": "\u16d2",
    "format-no-controller": "\u16d2",
    "tooltip-format-no-controller": "No Bluetooth controller detected"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 5
  },
  "custom/controls": {
    "format": "\u2637",
    "tooltip": "Control center",
    "on-click": "tamber-desktop --command controls"
  }
}
