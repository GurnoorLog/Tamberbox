{
  "layer": "top",
  "position": "top",
  "height": 36,
  "exclusive": true,
  "fixed-center": true,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": [
    "custom/tamber",
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "bluetooth",
    "custom/controls"
  ],
  "custom/tamber": {
    "format": "\u229e",
    "tooltip": "Open application launcher",
    "on-click": "tamber-desktop --command launcher",
    "on-click-right": "tamber-desktop --command games"
  },
  "sway/workspaces": {
    "all-outputs": true,
    "disable-scroll": true,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    }
  },
  "sway/window": {
    "max-length": 16,
    "format": "{title}",
    "rewrite": {
      "^$": "Desktop"
    }
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "cpu": {
    "interval": 3,
    "format": "CPU {usage}%",
    "min-length": 8
  },
  "memory": {
    "interval": 5,
    "format": "RAM {percentage}%",
    "min-length": 8
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip": true,
    "interval": 5
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "Muted",
    "scroll-step": 5,
    "min-length": 8
  },
  "bluetooth": {
    "format": "BT",
    "format-disabled": "BT off",
    "format-connected": "BT {num_connections}",
    "format-no-controller": "BT n/a",
    "tooltip-format-no-controller": "No Bluetooth controller detected"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 7
  },
  "custom/controls": {
    "format": "\u2637",
    "tooltip": "Control center",
    "on-click": "tamber-desktop --command controls"
  }
}
